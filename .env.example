# Local dev: keep empty so Vite proxy avoids browser CORS.
VITE_API_BASE_URL=

# Production/deployed frontend: set the live backend URL.
# VITE_API_BASE_URL=https://hoa-backend-adic.onrender.com

# Admin auth endpoints. Use absolute URLs only if auth lives on a different backend.
VITE_ADMIN_LOGIN_ENDPOINT=/api/admin/login
VITE_ADMIN_VERIFY_OTP_ENDPOINT=/api/admin/verify-otp
VITE_ADMIN_LOGOUT_ENDPOINT=/api/admin/logout

# auto accepts token/session login responses and OTP-required responses.
# Use direct for email/password only, or otp for forced OTP flow.
VITE_ADMIN_AUTH_MODE=auto
